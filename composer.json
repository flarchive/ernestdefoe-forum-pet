{
    "name": "ernestdefoe/forum-pet",
    "description": "Forum Pet: a shared mascot the whole community takes care of. It lives in the sidebar, follows the forum's mood, eats and plays once a day with each member, grows from an egg to a special form as the community cares for it, and celebrates milestones and holidays.",
    "keywords": [
        "flarum",
        "flarum-extension",
        "pet",
        "mascot",
        "tamagotchi",
        "engagement",
        "community",
        "game"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Ernest Defoe",
            "email": "ernestdefoe@gmail.com"
        }
    ],
    "homepage": "https://github.com/ernestdefoe/forum-pet",
    "support": {
        "issues": "https://github.com/ernestdefoe/forum-pet/issues",
        "source": "https://github.com/ernestdefoe/forum-pet"
    },
    "funding": [
        {
            "type": "other",
            "url": "https://buymeacoffee.com/ernestdefoe"
        }
    ],
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "ErnestDefoe\\ForumPet\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ErnestDefoe\\ForumPet\\Tests\\": "tests/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Forum Pet",
            "category": "feature",
            "icon": {
                "name": "fas fa-paw",
                "backgroundColor": "#f59e0b",
                "color": "#fff"
            },
            "optional-dependencies": [
                "flarum/gdpr",
                "ernestdefoe/festoon"
            ]
        }
    },
    "require-dev": {
        "flarum/gdpr": "^2.0",
        "flarum/phpstan": "^2.0",
        "flarum/testing": "^2.0"
    },
    "scripts": {
        "test": [
            "@test:integration"
        ],
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php",
        "analyse:phpstan": "phpstan analyse"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
        "analyse:phpstan": "Run static analysis"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
